# .env.ebay-worker.example — template for the eBay Browse API search worker.
#
# Copy to .env.ebay-worker on the host and chmod 600 (owner-only).
#
# CREDENTIALS DO NOT BELONG HERE. Unlike the browser workers, eBay reuses the
# EBAY_CLIENT_ID / EBAY_CLIENT_SECRET pair entered in
#   Settings -> Connectors -> eBay
# which AVAIL stores encrypted in the database. The worker reads them DB-first,
# so rotating the key in the UI reaches the worker with no file edit. Setting
# them below only serves as a fallback for a host with no DB credential.
#
# Loaded by: deploy/avail-ebay-worker.service (EnvironmentFile)

# --- Credentials (FALLBACK ONLY — prefer Settings -> Connectors) ------------
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=

# --- What to search --------------------------------------------------------
# eBay marketplace (X-EBAY-C-MARKETPLACE-ID header)
EBAY_MARKETPLACE_ID=EBAY_US
# Comma-separated eBay category ids. EMPTY = no category filter = all of eBay.
# Brokered board-level parts are scattered across categories, so a filter here
# silently hides supply. Leave blank unless you have a specific reason.
EBAY_CATEGORY_IDS=
# Include auction-only listings (a live auction price is not a quotable offer).
EBAY_INCLUDE_AUCTIONS=false

# --- Paging ----------------------------------------------------------------
# Results per Browse API page (the API's own maximum is 200).
EBAY_PAGE_LIMIT=50
# Pages walked per MPN.
EBAY_MAX_PAGES=2

# --- Pacing (no business hours, no random breaks — this is an API, not a browser)
# Browse API calls allowed per UTC day; the counter resets at midnight UTC.
EBAY_DAILY_CALL_BUDGET=4000
# Minimum seconds between calls.
EBAY_MIN_DELAY_SECONDS=3
# Sleep when the queue is empty.
EBAY_POLL_IDLE_SECONDS=30

# --- Safety caps -----------------------------------------------------------
# Hard cap on one MPN's search (all its pages).
EBAY_SEARCH_TIMEOUT_SECONDS=30
# Cross-requirement dedup window.
EBAY_DEDUP_WINDOW_DAYS=7
# Circuit-breaker self-heal cooldown after a trip.
EBAY_BREAKER_COOLDOWN_MINUTES=30
